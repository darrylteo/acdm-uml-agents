{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attribute delta",
  "description": "Only the attributes to add. Classes are not created, renamed, or removed here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classes"
  ],
  "properties": {
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "attributes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of a class already in the model."
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type",
                "description"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
