{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analyst brief",
  "description": "One entry per milestone. Categories mirror the scaffold packages, plus the rules the milestone states and an open list.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestones"
  ],
  "properties": {
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "name",
          "stakeholders",
          "flights",
          "timings",
          "systems",
          "messages",
          "rules",
          "other_concepts"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "name": {
            "type": "string"
          },
          "stakeholders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "flights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "systems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "other_concepts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
