@startuml
top to bottom direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 40
skinparam class {
  BackgroundColor<<entity>> #F1F8E9
  BackgroundColor<<boundary>> #E3F2FD
  BackgroundColor<<control>> #FFF3E0
  BorderColor #555555
}
skinparam packageStyle rectangle
hide empty members

package "Stakeholders" {
  class CdmPartner << (E,#C8E6C9) entity >> [[{A party that takes part in the Airport CDM process and originates or receives information about a flight. [M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12, M13, M14, M15, M16]}]] {
    +name : String [[{Identifies the CDM partner.}]]
    +receiveNotification(information : String) : void [[{Receives information relayed by a milestone process, e.g. 'inform all relevant Airport CDM Partners'.}]]
  }
  class AircraftOperator << (E,#C8E6C9) entity >> [[{The airline that submits the ATC Flight Plan and provides estimates such as TOBT. [M1, M3, M6, M7, M8, M9, M11, M12, M13]}]] {
    +submitFlightPlan(flightPlan : AtcFlightPlan) : void [[{Submits the ICAO ATC Flight Plan; the AO must provide correct information before the first E-DPI (Milestone 1).}]]
    +provideTobt(flight : Flight, value : DateTime) : void [[{Provides the most accurate TOBT taking into account the operational situation, integrating own strategy to compute TOBT (Milestone 9).}]]
  }
  class GroundHandler << (E,#C8E6C9) entity >> [[{The party that undertakes ground handling operations and provides ready and TOBT-related information. [M3, M6, M7, M8, M9, M11, M12]}]] {
    +commenceGroundHandling(flight : Flight) : void [[{Provides the Actual Commence of Ground Handling time (ACGT) (Milestone 8).}]]
    +provideArdt(flight : Flight) : void [[{Provides the Actual Ready Time when the aircraft is ready for start up/push-back (Milestone 12).}]]
  }
  class AtcUnit << (E,#C8E6C9) entity >> [[{An air traffic control unit (ACC, Approach, Tower) that receives the flight plan, issues TSAT, and approves start-up. [M1, M9, M10, M13, M14]}]] {
    +unitType : String [[{e.g. ACC, Approach Control Unit, Tower/TWR FDPS.}]]
    +issueTsat(flight : Flight) : void [[{Issues the Target Start-Up Approval Time t-minutes before EOBT, t agreed locally (Milestone 10).}]]
    +confirmTsatToPilot(flight : Flight) : void [[{Confirms TSAT to the pilot in order to maintain the aircraft in the pre-departure sequence (Milestone 13).}]]
    +approveStartUp(flight : Flight) : void [[{Grants start-up approval / push-back clearance (Milestone 14).}]]
  }
  class NetworkOperations << (E,#C8E6C9) entity >> [[{The network management function that issues CTOT, receives DPI messages, and monitors flight progress. [M1, M2, M3, M4, M5, M6, M7, M15]}]] {
    +issueCtot(flight : Flight) : DateTime [[{Issues a CTOT at EOBT-2hr to relevant ATS units and the departure aerodrome for regulated flights (Milestone 2).}]]
    +confirmFlight(flight : Flight) : void [[{Confirms the flight following consistency checking, allowing further local processing (Milestone 1).}]]
  }
  class Outstation << (E,#C8E6C9) entity >> [[{The departure aerodrome (ADEP) of an inbound flight, which provides the ATOT for that flight. [M3]}]] {
    +provideAtot(flight : Flight) : DateTime [[{Provides the ATOT from the outstation, available with accuracy +/- 1 minute (Milestone 3).}]]
  }
}

package "Flights" {
  class Flight << (E,#C8E6C9) entity >> [[{An arriving or departing flight tracked through the CDM process, carrying its operational status and time quantities. [M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12, M13, M14, M15, M16]}]] {
    +flightId : String [[{Identifies the flight.}]]
    +direction : String [[{Arrival or departure leg of a turn-round.}]]
    +operationalStatus : FlightOperationalStatus [[{The status set by each milestone, e.g. INITIATED, AIRBORNE, LANDED, SEQUENCED, DEPARTED/TAKE OFF.}]]
    +exot : Duration [[{Estimated Taxi-Out Time calculated by ATC based on predicted traffic load, gate/stand location, runway in use, and holding position waiting period (Milestone 9).}]]
    +exit : Duration [[{Estimated taxi-in time used with ELDT to compute EIBT and, with ALDT, to update EIBT (Milestones 4, 6).}]]
    +sobt : ScheduledTime [[{Scheduled Off-Block Time shared by ATC, Network Operations and Stand/Gate Management (Milestone 9).}]]
    +eobt : EstimatedTime [[{Estimated Off-Block Time used as the reference for the process timeline (Milestones 1,2,9).}]]
    +tobt : TargetTime [[{Target Off-Block Time, entered by AO/GH or calculated automatically, updated at multiple milestones.}]]
    +aobt : ActualTime [[{Actual Off-Block Time, when the aircraft pushes back/vacates the parking position (Milestone 15).}]]
    +eldt : EstimatedTime [[{Estimated Landing Time, updated using ATOT and Estimated Elapsed Time, and by FUM messages and radar (Milestones 1,2,3,4,5).}]]
    +aldt : ActualTime [[{Actual Landing Time, accuracy +/- 1 minute (Milestone 6).}]]
    +eibt : EstimatedTime [[{Estimated In-Block Time computed using ELDT and estimated taxi-in time, or ALDT+EXIT (Milestones 1,4,6).}]]
    +aibt : ActualTime [[{Actual In-Block Time, accuracy +/- 1 minute (Milestone 7).}]]
    +etot : EstimatedTime [[{Estimated Take-Off Time updated for a departure at flight plan activation (Milestone 1).}]]
    +ttot : TargetTime [[{Target Take-Off Time, calculated basis EIBT+MTTT+EXOT or TOBT+EXOT, updated with a tolerance before Network Operations is informed (Milestones 2-15).}]]
    +ctot : CalculatedTime [[{Calculated Take-Off Time issued by Network Operations for regulated flights at EOBT-2hr (Milestone 2).}]]
    +atot : ActualTime [[{Actual Take-Off Time, from outstation (Milestone 3) or at departure (Milestone 16), accuracy +/- 1 minute.}]]
    +acgt : ActualTime [[{Actual Commence of Ground Handling Time, accuracy +/- 1 minute (Milestone 8).}]]
    +asbt : ActualTime [[{Actual Start Boarding Time, accuracy +/- 1 minute (Milestone 11).}]]
    +ardt : ActualTime [[{Actual Ready Time, accuracy +/- 1 minute (Milestone 12).}]]
    +asrt : ActualTime [[{Actual Start-Up Request Time, accuracy +/- 1 minute (Milestone 13).}]]
    +asat : ActualTime [[{Actual Start-Up Approval Time, accuracy +/- 1 minute (Milestone 14).}]]
  }
  class TurnRound << (E,#C8E6C9) entity >> [[{An aircraft turn-round normally including an arriving and a departing flight, each with two related flight plans. [M1]}]] {
    +mttt : Duration [[{Minimum/estimated turn-round period used to calculate TOBT and TTOT for the departing flight (Milestones 6,7,8).}]]
  }
  class Aircraft << (E,#C8E6C9) entity >> [[{The physical aircraft operating a flight, whose type and registration may be updated from the flight plan. [M1]}]] {
    +registration : String [[{Aircraft registration provided before the first E-DPI (Milestone 1).}]]
    +type : String [[{Type of aircraft, which may be updated from the ATC Flight Plan (Milestone 1).}]]
  }
  class AtcFlightPlan << (E,#C8E6C9) entity >> [[{The ICAO flight plan submitted by the Aircraft Operator and distributed by IFPS, corresponding to the airport slot programme. [M1]}]] {
    +departureAerodrome : String [[{Departure aerodrome (ADEP) named in the flight plan.}]]
    +destinationAerodrome : String [[{Destination aerodrome named in the flight plan.}]]
    +estimatedElapsedTime : Duration [[{Elapsed time on the FPL used with ATOT to calculate ELDT (Milestone 3).}]]
    +isRepetitive : Boolean [[{Whether a repetitive flight plan (RFPL) has been submitted covering daily or weekly flights (Milestone 1).}]]
  }
  class AirportSlot << (E,#C8E6C9) entity >> [[{The airport slot programme entry against which the ATC Flight Plan is checked for consistency. [M1]}]] {
    +slotReference : String [[{Reference identifying the coordinated slot the flight plan must correspond to (Milestone 1).}]]
  }
  enum FlightOperationalStatus [[{[M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12, M15, M16]}]] {
    INITIATED
    REGULATED
    AIRBORNE
    FIR
    FINAL
    LANDED
    IN_BLOCK
    SEQUENCED
    BOARDING
    READY
    OFF_BLOCK
    DEPARTED_TAKE_OFF
  }
}

package "Timings" {
  class TimeQuantity << (E,#C8E6C9) entity >> [[{A named time quantity describing a flight's progress, combining a prefix (Scheduled, Estimated, Target, Actual, Calculated) with an event, kept as a history of successive values. [M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12, M13, M14, M15, M16]}]] {
    +quantityName : String [[{The named quantity, e.g. TOBT, EOBT, ELDT, EIBT, ETOT, TTOT, CTOT, ATOT, ALDT, AIBT, ACGT, ASBT, ARDT, ASRT, ASAT, AOBT, SOBT.}]]
    +event : EventType [[{The event this quantity describes, e.g. Off-Block, In-Block, Landing, Take-Off, Start-Up Approval.}]]
    +value : DateTime [[{The current time value of this quantity.}]]
    +originator : String [[{Who provided this value, e.g. ATC, AO/GH, ACARS, radar system.}]]
    +accuracy : String [[{Stated accuracy, e.g. +/- 1 minute for actual times.}]]
    +updatedAt : DateTime [[{Time this value was recorded.}]]
    +update(newValue : DateTime, originator : String) : void [[{Appends a new successive value with its originator and time of update, rather than overwriting, so a turn-round can be analysed afterwards.}]]
  }
  class ScheduledTime << (E,#C8E6C9) entity >> [[{A scheduled-prefix time quantity such as SOBT. [M1, M9]}]] {
  }
  class EstimatedTime << (E,#C8E6C9) entity >> [[{An estimated-prefix time quantity such as EOBT, ELDT, EIBT, ETOT. [M1, M2, M3, M4, M5]}]] {
  }
  class TargetTime << (E,#C8E6C9) entity >> [[{A target-prefix time quantity such as TOBT, TTOT, TSAT. [M2, M3, M4, M5, M6, M7, M8, M9, M10]}]] {
  }
  class ActualTime << (E,#C8E6C9) entity >> [[{An actual-prefix time quantity such as ATOT, ALDT, AIBT, ACGT, ASBT, ARDT, ASRT, ASAT, AOBT. [M3, M6, M7, M8, M11, M12, M13, M14, M15, M16]}]] {
  }
  class CalculatedTime << (E,#C8E6C9) entity >> [[{A calculated-prefix time quantity such as CTOT. [M2]}]] {
  }
  enum EventType [[{[M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12, M13, M14, M15, M16]}]] {
    OFF_BLOCK
    IN_BLOCK
    LANDING
    TAKE_OFF
    START_UP_APPROVAL
    START_BOARDING
    READY
    START_UP_REQUEST
    GROUND_HANDLING_START
  }
}

package "Milestones" {
  class Milestone << (C,#FFE0B2) control >> [[{One of the sixteen CDM events, each with its trigger, timing rule, effect on operational status, and procedure. [M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12, M13, M14, M15, M16]}]] {
    +milestoneNumber : Integer [[{The milestone's number, 1 to 16.}]]
    +milestoneName : String [[{The milestone's name, e.g. 'ATC Flight Plan Activated'.}]]
    +definitionText : String [[{The definition of the milestone as stated in the document.}]]
    +triggeredBy : String [[{What triggers this milestone's process, as stated under Procedures.}]]
    +operationalStatusChange : FlightOperationalStatus [[{The operational status the flight changes to at this milestone.}]]
    +recordOccurrence(time : DateTime) : void [[{Records that the milestone has occurred for a flight, at the stated time.}]]
  }
  class FlightPlanActivation << (C,#FFE0B2) control >> [[{Milestone 1: the ICAO flight plan is submitted to ATC and the Airport CDM Platform is initiated for the flight. [M1]}]] {
    +checkConsistency(flightPlan : AtcFlightPlan, slot : AirportSlot, flight : Flight) : Boolean [[{Checks consistency between the ATC Flight Plan, Airport Slot and Airport flight data before the first E-DPI is sent.}]]
    +updateEstimates(flight : Flight) : void [[{Updates ELDT and EIBT for an arrival, and ETOT for a departure.}]]
    +sendFirstEdpi(flight : Flight) : void [[{Sends the first E-DPI only if consistent information has been provided; not sent if information is missing or inconsistent.}]]
  }
  class Eobt2HrCheck << (C,#FFE0B2) control >> [[{Milestone 2: at EOBT-2hr, flights are known as regulated or not and receive a CTOT if regulated. [M2]}]] {
    +checkFlightEstimatesConsistency(flight : Flight) : Boolean [[{Checks whether AO/GH flight estimates are consistent with the ATC Flight Plan at EOBT-2hrs, before or after take-off from outstation.}]]
    +calculateTtot(flight : Flight) : DateTime [[{Calculates TTOT taking into account EIBT+MTTT+EXOT if later than EOBT+EXOT; if TOBT is manually input it overrides, so TTOT equals TOBT+EXOT.}]]
    +markAsRegulated(flight : Flight) : void [[{Marks appropriate fields as REGULATED for a flight receiving a CTOT.}]]
  }
  class TakeOffFromOutstation << (C,#FFE0B2) control >> [[{Milestone 3: the ATOT from the outstation (ADEP) is recorded. [M3]}]] {
    +checkLandingEstimateConsistency(flight : Flight) : Boolean [[{Checks whether AO/GH estimated landing time after take-off from outstation is consistent with the outbound ATC Flight Plan.}]]
    +calculateEldt(atot : DateTime, estimatedElapsedTime : Duration) : DateTime [[{Calculates ELDT using ATOT and the Estimated Elapsed Time on the FPL.}]]
    +calculateTtot(flight : Flight) : DateTime [[{Calculates TTOT as EIBT+MTTT+EXOT, or EOBT+EXOT if EOBT is later than EIBT+MTTT, or TOBT+EXOT if TOBT is available, respecting a TTOT tolerance of 5 minutes before informing Network Operations.}]]
  }
  class LocalRadarUpdate << (C,#FFE0B2) control >> [[{Milestone 4: the flight enters the FIR or local airspace of the destination airport. [M4]}]] {
    +checkTobtConsistency(flight : Flight) : Boolean [[{Checks whether the AO/GH TOBT is consistent with the ATC Flight Plan given the updated TOBT.}]]
    +computeEibt(eldt : DateTime, exit : Duration) : DateTime [[{Computes EIBT using the ELDT and the estimated taxi-in time (EXIT).}]]
    +informNetworkOperationsIfTtotChanges(flight : Flight) : void [[{Informs Network Operations when the TTOT changes by more than the agreed TTOT tolerance.}]]
  }
  class FinalApproach << (C,#FFE0B2) control >> [[{Milestone 5: the flight enters the Final Approach phase at the destination airport. [M5]}]] {
    +checkTobtConsistency(flight : Flight) : Boolean [[{Checks whether the AO/GH TOBT is consistent with the ATC Flight Plan given the updated TOBT.}]]
    +informNetworkOperationsIfTtotChanges(flight : Flight) : void [[{Informs Network Operations when the TTOT changes by more than the agreed TTOT tolerance.}]]
  }
  class Landed << (C,#FFE0B2) control >> [[{Milestone 6: ALDT, the time an aircraft touches down on a runway. [M6]}]] {
    +checkTobtConsistency(flight : Flight) : Boolean [[{Checks whether the AO/GH TOBT is consistent with the ATC Flight Plan given the updated TOBT or ATC Flight Plan.}]]
    +updateEibt(aldt : DateTime, exit : Duration) : DateTime [[{Updates EIBT according to ALDT + EXIT.}]]
    +informNetworkOperationsIfTtotChanges(flight : Flight) : void [[{Informs Network Operations when TTOT changes by more than the agreed TTOT tolerance.}]]
  }
  class InBlock << (C,#FFE0B2) control >> [[{Milestone 7: AIBT, the time an aircraft arrives in-blocks; ACGT is considered to commence at AIBT. [M7]}]] {
    +checkTobtConsistency(flight : Flight) : Boolean [[{Checks whether the AO/GH TOBT is consistent with the ATC Flight Plan given the updated TOBT or ATC Flight Plan.}]]
    +updateTobtTtot(flight : Flight) : void [[{Updates TOBT and TTOT, calculated on the basis of the estimated turn-round period for the departing flight.}]]
  }
  class GroundHandlingStarted << (C,#FFE0B2) control >> [[{Milestone 8: commencement of ground handling operations (ACGT), specific to first-of-day or long-parked flights. [M8]}]] {
    +checkTobtConsistency(flight : Flight) : Boolean [[{Checks whether the AO/GH TOBT is consistent with the ATC Flight Plan given the updated TOBT or ATC Flight Plan.}]]
    +updateTobtTtot(flight : Flight) : void [[{Updates TOBT, calculated on the basis of the estimated turn-round period for the departing flight.}]]
  }
  class FinalConfirmationOfTobt << (C,#FFE0B2) control >> [[{Milestone 9: the time the Aircraft Operator/Ground Handler provides its most accurate TOBT. [M9]}]] {
    +localParameterT : Duration [[{t minutes before EOBT, a parameter time agreed locally, when this confirmation is provided.}]]
    +checkTobtConsistency(flight : Flight) : Boolean [[{Performed at a predefined local time to confirm TOBT prior to TSAT issue and verify feasibility of ATC Flight Plan estimates given the updated TOBT.}]]
    +calculateExot(trafficLoad : String, gateLocation : String, runwayInUse : String, holdingPeriod : Duration) : Duration [[{ATC calculates and provides EXOT based on predicted traffic load, gate/stand location, runway in use, and waiting period at the Holding Position.}]]
  }
  class TsatIssued << (C,#FFE0B2) control >> [[{Milestone 10: the time ATC issues the Target Start-Up Approval Time. [M10]}]] {
    +localParameterT : Duration [[{t-minutes before EOBT, a parameter agreed locally, when TSAT is issued.}]]
    +tobtUpdateThreshold : Integer [[{Locally defined tolerance for the number of TOBT updates permitted after TSAT has been issued.}]]
    +informPartnersOfTsat(flight : Flight) : void [[{Informs all relevant partners of the TSAT allocated to the flight; Network Operations is informed by a T-DPI-s for non-regulated flights.}]]
    +checkTobtUpdateCount(flight : Flight) : Boolean [[{Checks whether the number of TOBT updates after TSAT has been issued exceeds a locally defined tolerance.}]]
  }
  class BoardingStarts << (C,#FFE0B2) control >> [[{Milestone 11: the gate is open for passengers to physically start boarding. [M11]}]] {
    +informPartnersOfAsbt(flight : Flight) : void [[{Informs all relevant Airport CDM Partners of Actual Start Boarding Time (ASBT).}]]
    +checkBoardingStatus(flight : Flight) : Boolean [[{At a locally defined time before TOBT, checks whether boarding starts in time to respect TOBT and informs the AO/GH if TOBT needs updating.}]]
  }
  class AircraftReady << (C,#FFE0B2) control >> [[{Milestone 12: all doors closed, boarding bridge removed, push-back vehicle connected, ready to taxi (ARDT). [M12]}]] {
    +informPartnersOfArdt(flight : Flight) : void [[{Informs all relevant Airport CDM Partners of ARDT and that the aircraft is ready for start-up/push-back.}]]
    +alertIfNoReadyStatus(flight : Flight) : void [[{At TOBT + tolerance, informs the AO/GH that TOBT has passed and no ARDT or Ready Status (RDY) has been received.}]]
  }
  class StartUpRequested << (C,#FFE0B2) control >> [[{Milestone 13: the time that start-up is requested (ASRT), based on pilot request. [M13]}]] {
    +informPartnersOfAsrt(flight : Flight) : void [[{Informs all relevant Airport CDM Partners of Actual Start-up Request Time (ASRT).}]]
    +alertIfNoStartUpRequested(flight : Flight) : void [[{If start-up request is not made by TSAT + tolerance, informs the AO/GH that no start-up has been requested, who should update TOBT.}]]
  }
  class StartUpApproved << (C,#FFE0B2) control >> [[{Milestone 14: ASAT, the time an aircraft receives its start-up approval. [M14]}]] {
    +informPartnersOfAsat(flight : Flight) : void [[{Informs all relevant Airport CDM Partners of ASAT and that the aircraft has received start-up approval/push-back clearance.}]]
    +checkAsatAgainstTsat(flight : Flight) : Boolean [[{Checks if ASAT is in accordance with TSAT; if start-up approval is not granted at TSAT + tolerance, all partners are informed and the flight is re-sequenced.}]]
  }
  class OffBlock << (C,#FFE0B2) control >> [[{Milestone 15: AOBT, the time the aircraft pushes back/vacates the parking position. [M15]}]] {
    +informPartnersOfAobt(flight : Flight) : void [[{Informs all relevant Airport CDM Partners of AOBT and that the aircraft has commenced push-back/taxi from parking position.}]]
    +checkTtotAgainstTolerance(flight : Flight) : void [[{AOBT always triggers an A-DPI message; after the first A-DPI, checks TTOT updates against the TTOT tolerance before Network Operations is informed with a new A-DPI.}]]
  }
  class TakeOff << (C,#FFE0B2) control >> [[{Milestone 16: ATOT, the time an aircraft takes off from the runway. [M16]}]] {
    +informPartnersOfAtot(flight : Flight) : void [[{Informs all relevant Airport CDM Partners about the actual take-off.}]]
    +removeFromDepartureSequence(flight : Flight) : void [[{An airborne message is generated and the flight is removed from the departure sequence.}]]
  }
}

package "Systems" {
  class AirportCdmPlatform << (C,#FFE0B2) control >> [[{The Airport CDM Platform that is initiated for a flight, processes all available information, and performs ACISP actions. [M1, M2, M4, M12]}]] {
    +initiateForFlight(flight : Flight) : void [[{Initiates the Airport CDM Platform for the flight and processes all available information (Milestone 1).}]]
    +markFieldsAsRegulated(flight : Flight) : void [[{Marks appropriate fields as REGULATED (Milestone 2).}]]
    +computeTobtAutomatically(flight : Flight) : DateTime [[{Calculates a new TOBT automatically following an update of ELDT (Milestone 4).}]]
    +receiveInput(flight : Flight, input : String) : void [[{Receives an input to the Airport CDM Platform, triggering the Aircraft Ready procedure (Milestone 12).}]]
  }
  class AtcSystem << (B,#BBDEFB) boundary >> [[{The ATC/radar/A-SMGCS system that detects a flight and provides actual times such as ATOT, ALDT and AIBT. [M4, M5, M6, M7, M16]}]] {
    +systemType : String [[{e.g. ACC, Approach Control Unit, A-SMGCS, Tower FDPS, Radar.}]]
    +detectFlight(ssrCode : String) : void [[{Detects a flight based upon the assigned SSR code when it crosses a defined FIR/ATC boundary or range/position/level (Milestones 4,5).}]]
  }
  class Acars << (B,#BBDEFB) boundary >> [[{The Aircraft Communications Addressing and Reporting System that signals ON/OFF/IN/OUT events. [M6, M7, M15, M16]}]] {
    +signalEvent(event : EventType) : void [[{Signals ACARS=ON (landing), ACARS=IN (in-block), ACARS=OUT (off-block), or ACARS=OFF (take-off).}]]
  }
  class Ifps << (B,#BBDEFB) boundary >> [[{The Integrated Initial Flight Plan Processing System that distributes the ATC Flight Plan to all involved ATC units. [M1]}]] {
    +distributeFlightPlan(flightPlan : AtcFlightPlan) : void [[{Distributes the ATC Flight Plan submitted by the Aircraft Operator to all involved ATC units including departure and destination aerodromes.}]]
  }
  class Etfms << (B,#BBDEFB) boundary >> [[{The system Network Operations uses to monitor a flight's progress within 3 hours flying time of the destination airport. [M3]}]] {
    +monitorProgress(flight : Flight) : void [[{Monitors progress of the flight and triggers sending of a Flight Update Message (FUM) with updates of the flight's progress.}]]
  }
}

package "Messages" {
  class DpiMessage << (B,#BBDEFB) boundary >> [[{A Departure Planning Information message exchanged with Network Operations as part of the DPI process. [M1, M2, M3, M10, M15]}]] {
    +sentTime : DateTime [[{When the message was sent.}]]
    +sender : String [[{The party or system sending the message.}]]
  }
  class EDpiMessage << (B,#BBDEFB) boundary >> [[{The first E-DPI message, sent only if consistent SOBT, aircraft registration and first destination data have been provided. [M1]}]] {
  }
  class TDpiMessage << (B,#BBDEFB) boundary >> [[{The T-DPI message informing Network Operations of the updated take-off time estimate at EOBT-2hr. [M2]}]] {
  }
  class TDpiTMessage << (B,#BBDEFB) boundary >> [[{The T-DPI-t message informing Network Operations of updated take-off time estimates at take-off from outstation. [M3]}]] {
  }
  class TDpiSMessage << (B,#BBDEFB) boundary >> [[{The T-DPI-s message informing Network Operations of the TSAT for non-regulated flights. [M10]}]] {
  }
  class ADpiMessage << (B,#BBDEFB) boundary >> [[{The A-DPI message that AOBT always triggers to Network Operations, and which carries updated TTOT thereafter. [M15]}]] {
  }
  class FumMessage << (B,#BBDEFB) boundary >> [[{The Flight Update Message sent by Network Operations providing updates of the flight's progress. [M2, M3]}]] {
  }
  class FsaMessage << (B,#BBDEFB) boundary >> [[{The FSA message sent at Take-Off. [M16]}]] {
  }
  class MvtMessage << (B,#BBDEFB) boundary >> [[{The MVT message sent at Take-Off. [M16]}]] {
  }
  class ReadyStatusMessage << (B,#BBDEFB) boundary >> [[{The Ready Status (RDY) message confirming that the flight follows the indicated TOBT. [M12]}]] {
  }
}

