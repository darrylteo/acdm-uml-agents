@startuml
top to bottom direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 40
skinparam class {
  BackgroundColor<<entity>> #F1F8E9
  BackgroundColor<<boundary>> #E3F2FD
  BackgroundColor<<control>> #FFF3E0
  BorderColor #555555
}
skinparam packageStyle rectangle
hide empty members

package "Stakeholders" {
  class AirportCdmPartner << (E,#C8E6C9) entity >> [[{A generic party involved in the Airport CDM process that originates or receives flight information and is informed of milestone events. [M1, M9, M10, M11, M12, M13, M14, M15, M16]}]] {
    +name : String [[{Identifying name of the partner.}]]
    +role : String [[{The partner's role in the CDM process.}]]
  }
  class AircraftOperator << (E,#C8E6C9) entity >> [[{The airline or operator that submits the ATC flight plan, provides TOBT and turn-round information, and manages the aircraft's turn-round. [M1, M3, M4, M5, M6, M7, M8, M9, M11, M12]}]] {
    +submitAtcFlightPlan(flightPlan : AtcFlightPlan) : void [[{The ATC Flight Plan is submitted by the Aircraft Operator and distributed by the IFPS (M1).}]]
    +provideTobt(flight : Flight, tobt : TimeQuantity) : void [[{The Aircraft Operator/Ground Handler provides the most accurate TOBT taking into account the operational situation, integrating their own strategy (M9).}]]
  }
  class GroundHandler << (E,#C8E6C9) entity >> [[{The party that manages ground handling operations for the flight and coordinates with the Aircraft Operator on TOBT and turn-round. [M6, M7, M8, M9, M11, M12]}]] {
  }
  class AirTrafficControl << (E,#C8E6C9) entity >> [[{The air traffic control unit (including Area Control Centre/Approach Control Unit and Tower) that issues TSAT, TWR instructions, and start-up approvals, and detects flights via radar/A-SMGCS/FDPS. [M2, M4, M5, M9, M10, M12, M13, M14, M16]}]] {
    +unitType : String [[{The type of ATC unit, e.g. Area Control Centre, Approach Control Unit, Tower.}]]
  }
  class NetworkOperations << (E,#C8E6C9) entity >> [[{The network management function that issues CTOT, distributes flight plans, monitors flight progress via ETFMS, and receives DPI/FUM messages. [M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M15]}]] {
    +issueCtot(flight : Flight) : TimeQuantity [[{The CTOT is issued by Network Operations at EOBT-2 hr if the flight is regulated (M2).}]]
  }
  class StandGateManagement << (E,#C8E6C9) entity >> [[{The party responsible for stand and gate allocation decisions that depend on accurate ELDT and EIBT. [M4]}]] {
  }
}

package "Flights" {
  class Flight << (E,#C8E6C9) entity >> [[{A single flight (arrival or departure) that is tracked through the CDM milestones with its operational status and time quantities. [M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12, M13, M14, M15, M16]}]] {
    +flightId : String [[{Identifier of the flight.}]]
    +direction : FlightDirection [[{Whether the flight is an arrival or a departure.}]]
    +operationalStatus : OperationalStatus [[{The current operational status of the flight, changed at each milestone (e.g. INITIATED, AIRBORNE, LANDED, IN-BLOCK, SEQUENCED, BOARDING, READY, OFF-BLOCK, DEPARTED/TAKE OFF).}]]
    +isRegulated : Boolean [[{Marked REGULATED at EOBT-2 hr if the flight receives a CTOT from Network Operations (M2).}]]
    +timeQuantities : TimeQuantity [[{The successive scheduled, estimated, target, actual, and calculated time values recorded for this flight.}]]
  }
  class TurnRound << (E,#C8E6C9) entity >> [[{The aircraft turn-round comprising a related arriving and departing flight, described by a defined turn-round period. [M1, M6, M7, M8]}]] {
    +mttt : Duration [[{The defined/estimated minimum turn-round time period used to calculate TOBT/TTOT for the departing flight (M6, M7, M8).}]]
  }
  class Aircraft << (E,#C8E6C9) entity >> [[{The physical aircraft operating a flight, identified by registration and type. [M1]}]] {
    +registration : String [[{Aircraft registration, which the flight plan may be used to update (M1).}]]
    +type : String [[{Type of aircraft, which the flight plan may be used to update (M1).}]]
  }
  class AtcFlightPlan << (E,#C8E6C9) entity >> [[{The ICAO flight plan submitted to ATC for a flight, distributed by the IFPS, and checked for consistency with the airport slot and flight data. [M1, M2, M3]}]] {
    +eobt : TimeQuantity [[{Estimated Off-Block Time on the flight plan.}]]
    +estimatedElapsedTime : Duration [[{Estimated Elapsed Time on the FPL, used with ATOT to calculate ELDT (M3).}]]
    +departureAerodrome : String [[{ADEP, the departure aerodrome.}]]
    +destinationAerodrome : String [[{The destination aerodrome.}]]
    +isRepetitive : Boolean [[{Whether the submission is a repetitive flight plan (RFPL) covering daily or weekly flights (M1).}]]
  }
  class AirportSlot << (E,#C8E6C9) entity >> [[{The airport slot programme entry that the ATC Flight Plan must correspond to, used to initiate the outbound flight at coordinated airports. [M1]}]] {
    +sobt : TimeQuantity [[{Scheduled Off-Block Time from the airport slot, fed with the SOBT as early as possible for consistent DPI messaging (M1).}]]
    +slotProgramme : String [[{The airport slot programme the flight plan must correspond to.}]]
  }
  enum FlightDirection [[{[M1]}]] {
    ARRIVAL
    DEPARTURE
  }
  enum OperationalStatus [[{[M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12, M13, M14, M15, M16]}]] {
    INITIATED
    REGULATED
    AIRBORNE
    FIR
    FINAL
    LANDED
    IN_BLOCK
    SEQUENCED
    BOARDING
    READY
    OFF_BLOCK
    DEPARTED_TAKE_OFF
  }
}

package "Timings" {
  class TimeQuantity << (E,#C8E6C9) entity >> [[{A single dated value of a named time quantity (identified by prefix and event) for a flight, recorded with its originator, accuracy and update time; every successive value is kept rather than overwritten. [M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12, M13, M14, M15, M16]}]] {
    +prefixType : PrefixType [[{The prefix of the time quantity: Scheduled, Estimated, Target, Actual, or Calculated.}]]
    +eventType : EventType [[{The event the time quantity relates to, e.g. Off-Block, In-Block, Landing, Take-Off, Start-Up Approval.}]]
    +value : DateTime [[{The time value itself.}]]
    +originator : String [[{Who or what provided/updated this value (e.g. ATC, ACARS, AO/GH, Airport CDM Platform).}]]
    +accuracy : String [[{Stated accuracy, e.g. +/- 1 minute for actual times (M3,6,7,8,11,12,13,14,15,16).}]]
    +tolerance : Duration [[{Agreed tolerance before a change must be notified, e.g. 5 minute TTOT tolerance before take off from outstation (M3), or locally agreed TSAT tolerance (M13,14).}]]
    +recordedAt : DateTime [[{Time at which this value was appended/recorded.}]]
    +update(newValue : DateTime, originator : String, timestamp : DateTime) : TimeQuantity [[{Appends a new successive value for this time quantity rather than overwriting the previous one, so the turn-round can be analysed afterwards.}]]
    +calculateEldtFromAtot(atot : TimeQuantity, estimatedElapsedTime : Duration) : DateTime [[{Using the ATOT, ELDT is calculated using the Estimated Elapsed Time on the FPL (M3).}]]
    +calculateEibt(landingTime : TimeQuantity, exit : Duration) : DateTime [[{EIBT is computed using the ELDT/ALDT and the estimated taxi-in time (EXIT) (M4, M6).}]]
    +calculateTtot(eibt : TimeQuantity, mttt : Duration, exot : Duration, eobt : TimeQuantity, tobt : TimeQuantity) : DateTime [[{Calculation basis for TTOT takes into account EIBT+MTTT+EXOT, if later than EOBT+EXOT; if TOBT is manually input it overrides the EIBT+MTTT estimate, so TTOT equals TOBT+EXOT (M2, M3).}]]
    +checkTtotToleranceExceeded(newTtot : DateTime, tolerance : Duration) : Boolean [[{Checks whether TTOT has changed by more than the agreed TTOT tolerance, in which case Network Operations must be informed (M4-M10, M15).}]]
  }
  enum PrefixType [[{[M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12, M13, M14, M15, M16]}]] {
    SCHEDULED
    ESTIMATED
    TARGET
    ACTUAL
    CALCULATED
  }
  enum EventType [[{[M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12, M13, M14, M15, M16]}]] {
    OFF_BLOCK
    IN_BLOCK
    LANDING
    TAKE_OFF
    START_UP_APPROVAL
    TAKE_OFF_OUTSTATION
    GROUND_HANDLING_START
    START_BOARDING
    READY
    START_UP_REQUEST
  }
}

package "Milestones" {
  class Milestone << (C,#FFE0B2) control >> [[{A superclass for the sixteen CDM milestone events, each with a definition, timing rule, trigger, effect, and procedure that changes the flight's operational status. [M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12, M13, M14, M15, M16]}]] {
    +milestoneNumber : Integer [[{The number of the milestone (1-16).}]]
    +definition : String [[{The document's definition of the milestone event.}]]
    +timingRule : String [[{The timing rule stated by the document for when the milestone occurs.}]]
    +dataQuality : String [[{The stated data quality/accuracy for information at this milestone.}]]
    +trigger : String [[{What the document states triggers this milestone's process.}]]
    +operationalStatusChange : OperationalStatus [[{The operational status the flight changes to at this milestone.}]]
  }
  class AtcFlightPlanActivated << (C,#FFE0B2) control >> [[{Milestone 1: the ICAO flight plan is submitted to ATC and the Airport CDM Platform is initiated for the flight. [M1]}]] {
    +checkConsistency(flightPlan : AtcFlightPlan, slot : AirportSlot, flight : Flight) : Boolean [[{Checks consistency between the ATC Flight Plan, Airport Slot and Airport flight data before the first E-DPI is sent.}]]
    +sendFirstEdpi(flight : Flight) : void [[{Confirms the flight to Network Operations via the first E-DPI message with consistent SOBT, aircraft registration and first destination data; not sent if information is missing or inconsistent.}]]
    +updateEldtEibtEtot(flight : Flight) : void [[{ELDT and EIBT updated for an arrival; EOBT and ETOT updated for a departure.}]]
  }
  class Eobt2hrCheck << (C,#FFE0B2) control >> [[{Milestone 2: at EOBT-2 hr regulated flights receive a CTOT and estimates are checked against the ATC Flight Plan. [M2]}]] {
    +checkFlightEstimatesConsistency(flight : Flight) : Boolean [[{Checks whether AO/GH flight estimates are consistent with the ATC Flight Plan to verify feasibility of the estimated off-block time at EOBT-2 hr.}]]
    +sendTDpi(flight : Flight) : void [[{Informs Network Operations about the updated take off time estimate using a T-DPI message at EOBT-2 hrs.}]]
    +markAsRegulated(flight : Flight) : void [[{Marks appropriate fields as REGULATED when the flight receives a CTOT.}]]
  }
  class TakeOffFromOutstation << (C,#FFE0B2) control >> [[{Milestone 3: the ATOT from the outstation (ADEP) is recorded and used to update ELDT and downstream estimates. [M3]}]] {
    +checkLandingEstimateConsistency(flight : Flight) : Boolean [[{Checks whether AO/GH estimated landing time after take off from outstation is consistent with the outbound ATC Flight Plan.}]]
    +sendTDpiT(flight : Flight) : void [[{Informs Network Operations about the updated take off time estimate using a T-DPI-t message; a TTOT tolerance of 5 minutes is respected first.}]]
  }
  class LocalRadarUpdate << (C,#FFE0B2) control >> [[{Milestone 4: the flight enters the FIR or local airspace of the destination airport, triggering a TOBT/ELDT update. [M4]}]] {
    +commenceTobtProcess(flight : Flight) : void [[{Commences the TOBT process and checks whether the AO/GH TOBT is consistent with the ATC Flight Plan.}]]
    +informNetworkOperationsIfTtotExceedsTolerance(flight : Flight) : void [[{Network Operations is informed when TTOT changes by more than the agreed TTOT tolerance.}]]
  }
  class FinalApproach << (C,#FFE0B2) control >> [[{Milestone 5: the flight enters the Final Approach phase, prompting a further TOBT/ELDT update, typically 2 to 5 minutes from landing. [M5]}]] {
    +commenceTobtProcess(flight : Flight) : void [[{Commences the TOBT process and checks whether the AO/GH TOBT is consistent with the ATC Flight Plan.}]]
    +informNetworkOperationsIfTtotExceedsTolerance(flight : Flight) : void [[{Network Operations is informed when TTOT changes by more than the agreed TTOT tolerance.}]]
  }
  class Landed << (C,#FFE0B2) control >> [[{Milestone 6: ALDT, the actual landing time, triggers an update of downstream TOBT, TTOT and EIBT estimates. [M6]}]] {
    +checkTobtConsistency(flight : Flight) : Boolean [[{Checks whether the AO/GH TOBT is consistent with the ATC Flight Plan given the updated TOBT/ATC Flight Plan.}]]
    +updateEibtFromAldt(flight : Flight, exit : Duration) : DateTime [[{EIBT can be updated according to ALDT+EXIT.}]]
    +informNetworkOperationsIfTtotExceedsTolerance(flight : Flight) : void [[{A TTOT tolerance is respected before Network Operations is informed of the updated TTOT.}]]
  }
  class InBlockMilestone << (C,#FFE0B2) control >> [[{Milestone 7: AIBT, the actual in-block time, triggers an update of downstream TOBT and TTOT estimates. [M7]}]] {
    +checkTobtConsistency(flight : Flight) : Boolean [[{Checks whether the AO/GH TOBT is consistent with the ATC Flight Plan given the updated TOBT.}]]
    +updateTobtTtotFromTurnround(flight : Flight, mttt : Duration) : void [[{TOBT and TTOT are updated automatically or manually, calculated on the basis of the estimated turn-round period for the departing flight.}]]
  }
  class GroundHandlingStarted << (C,#FFE0B2) control >> [[{Milestone 8: ACGT, the commencement of ground handling operations, triggers an update of TOBT for flights first of the day or long-parked. [M8]}]] {
    +checkTobtConsistency(flight : Flight) : Boolean [[{Checks whether the AO/GH TOBT is consistent with the ATC Flight Plan given the updated TOBT.}]]
    +updateTobtFromTurnround(flight : Flight, mttt : Duration) : void [[{TOBT is updated automatically or manually, calculated on the basis of the estimated turn-round period for the departing flight.}]]
  }
  class FinalConfirmationOfTobt << (C,#FFE0B2) control >> [[{Milestone 9: the time at which the Aircraft Operator/Ground Handler provides its most accurate TOBT, t minutes before EOBT. [M9]}]] {
    +confirmTobt(flight : Flight, tMinutesBeforeEobt : Integer) : void [[{Checks TOBT quality at a predefined local time before TSAT issue, triggered by a new TOBT or TTOT update; no need to reconfirm if manually modified before.}]]
    +calculateExot(flight : Flight) : Duration [[{Following receipt of TOBT, the ATC system calculates and provides the Estimated Taxi-Out Time (EXOT) based on predicted traffic load, gate/stand location, runway in use, and waiting period at the holding position.}]]
  }
  class TsatIssued << (C,#FFE0B2) control >> [[{Milestone 10: ATC issues the Target Start Up Approval Time, stabilising the flight into the pre-departure sequence. [M10]}]] {
    +issueTsat(flight : Flight) : TimeQuantity [[{Informs all relevant partners of the TSAT allocated to the flight; Network Operations is informed by a T-DPI-s for non-regulated flights.}]]
    +checkTobtUpdateCount(flight : Flight, threshold : Integer) : Boolean [[{Checks whether the number of TOBT updates exceeds a locally defined tolerance after TSAT has been issued; if exceeded the TOBT input is processed per local procedure.}]]
  }
  class BoardingStarts << (C,#FFE0B2) control >> [[{Milestone 11: the gate is opened for passengers to physically start boarding. [M11]}]] {
    +recordAsbt(flight : Flight) : TimeQuantity [[{Informs all relevant Airport CDM Partners of the Actual Start Boarding Time (ASBT) when it occurs.}]]
    +checkBoardingStatus(flight : Flight, minutesBeforeTobt : Integer) : Boolean [[{At a locally defined time before TOBT, checks the boarding status and informs the AO/GH if TOBT needs updating.}]]
  }
  class AircraftReady << (C,#FFE0B2) control >> [[{Milestone 12: all doors closed, boarding bridge removed, push back vehicle connected; the aircraft is ready to taxi (ARDT). [M12]}]] {
    +recordArdt(flight : Flight) : TimeQuantity [[{Informs all relevant Airport CDM Partners of the Actual Ready Time (ARDT) in the Airport CDM Platform, confirming the aircraft is ready for start up/push-back.}]]
    +checkReadyStatusReceived(flight : Flight, tolerance : Duration) : Boolean [[{At TOBT+tolerance, informs the AO/GH that TOBT has passed and no ARDT or Ready Status (RDY) has been received.}]]
  }
  class StartUpRequested << (C,#FFE0B2) control >> [[{Milestone 13: the time that start up is requested by the pilot via ATC (ASRT). [M13]}]] {
    +recordAsrt(flight : Flight) : TimeQuantity [[{Informs all relevant Airport CDM Partners of the Actual Start-up Request Time (ASRT) when it occurs.}]]
    +checkStartUpRequestedWithinTolerance(flight : Flight, tolerance : Duration) : Boolean [[{Alerts all relevant partners when no start up has been requested inside the locally agreed TSAT tolerance window; if not made by TSAT+tolerance, AO/GH is informed and should update TOBT.}]]
  }
  class StartUpApproved << (C,#FFE0B2) control >> [[{Milestone 14: ATC grants start up approval to the aircraft (ASAT). [M14]}]] {
    +recordAsat(flight : Flight) : TimeQuantity [[{Informs all relevant Airport CDM Partners of the Actual Start-up Approval Time (ASAT), confirming the aircraft has received start up approval/push-back clearance.}]]
    +checkAsatAgainstTsat(flight : Flight, tolerance : Duration) : Boolean [[{Checks if ASAT is in accordance with TSAT; if start up approval is not granted at TSAT+tolerance, all relevant partners are informed and the flight is re-sequenced.}]]
  }
  class OffBlockMilestone << (C,#FFE0B2) control >> [[{Milestone 15: AOBT, the time the aircraft pushes back/vacates the parking position. [M15]}]] {
    +recordAobt(flight : Flight) : TimeQuantity [[{Informs all relevant Airport CDM Partners of the Actual Off-Block Time (AOBT), confirming push-back/taxi has commenced.}]]
    +sendADpi(flight : Flight) : void [[{AOBT always triggers an A-DPI message to Network Operations, or at a defined time prior to TTOT in case of remote holding.}]]
    +checkTtotToleranceAndInform(flight : Flight) : Boolean [[{After the first A-DPI is sent, checks TTOT updates against the TTOT tolerance before Network Operations is informed with a new A-DPI of the updated TTOT.}]]
  }
  class TakeOffMilestone << (C,#FFE0B2) control >> [[{Milestone 16: ATOT, the actual take off time, ending the departure sequence for the flight. [M16]}]] {
    +recordAtot(flight : Flight) : TimeQuantity [[{Informs all relevant Airport CDM Partners about the actual take off, triggered by Tower FDPS, A-SMGCS/Radar detection or ACARS.}]]
    +sendFsaAndMvtMessages(flight : Flight) : void [[{FSA and MVT messages are sent on take off.}]]
    +removeFromDepartureSequence(flight : Flight) : void [[{An airborne message is generated and the flight is removed from the departure sequence.}]]
  }
}

package "Systems" {
  class AirportCdmPlatform << (C,#FFE0B2) control >> [[{The Airport CDM Platform system that is initiated per flight, processes available information, computes and records time quantities, marks status fields, and informs Airport CDM Partners at each milestone. [M1, M2, M4, M10, M11, M12, M13, M14, M15]}]] {
    +initiateForFlight(flight : Flight) : void [[{Initiated for the flight and processes all available information (M1).}]]
    +markAsRegulated(flight : Flight) : void [[{Marks appropriate fields as REGULATED for a flight that receives a CTOT (M2).}]]
    +calculateTobtAutomatically(flight : Flight) : TimeQuantity [[{A new TOBT can be calculated automatically by the Airport CDM Platform following an ELDT update (M4).}]]
    +informPartners(flight : Flight, eventType : EventType) : void [[{Informs all relevant Airport CDM Partners of an actual time event (ASBT, ARDT, ASRT, ASAT, AOBT, ATOT) as it occurs (M11-16).}]]
  }
  class AtcSystem << (B,#BBDEFB) boundary >> [[{The ATC technical system(s) (radar, A-SMGCS, Tower FDPS) that detect flight events and provide time quantities such as ATOT, ALDT and TSAT. [M3, M4, M5, M6, M9, M10, M16]}]] {
  }
  class Acars << (B,#BBDEFB) boundary >> [[{The ACARS system aboard equipped aircraft that provides actual time events (ON, IN, OUT, OFF) such as ALDT, AIBT, AOBT and ATOT. [M6, M7, M15, M16]}]] {
  }
  class Ifps << (B,#BBDEFB) boundary >> [[{The system that distributes the submitted ATC Flight Plan to all involved ATC units. [M1]}]] {
  }
  class EtfmsSystem << (B,#BBDEFB) boundary >> [[{The system used by Network Operations to monitor flight progress and issue Flight Update Messages. [M3]}]] {
  }
}

package "Messages" {
  class DpiMessage << (B,#BBDEFB) boundary >> [[{A Departure Planning Information message sent by the Airport CDM Platform to Network Operations to communicate flight time estimates. [M1, M2, M3, M10, M15]}]] {
    +type : DpiType [[{The kind of DPI message: E-DPI, T-DPI, T-DPI-t, T-DPI-s, or A-DPI.}]]
    +timestamp : DateTime [[{When the message was sent.}]]
  }
  class FumMessage << (B,#BBDEFB) boundary >> [[{A Flight Update Message sent by Network Operations providing updates of a flight's progress used to update ELDT. [M2, M3]}]] {
    +timestamp : DateTime [[{When the message was sent.}]]
  }
  class FsaMessage << (B,#BBDEFB) boundary >> [[{An airborne/FSA message sent on take off. [M16]}]] {
    +timestamp : DateTime [[{When the message was sent.}]]
  }
  class MvtMessage << (B,#BBDEFB) boundary >> [[{A movement (MVT) message sent on take off. [M16]}]] {
    +timestamp : DateTime [[{When the message was sent.}]]
  }
  enum DpiType [[{[M1, M2, M3, M10, M15]}]] {
    E_DPI
    T_DPI
    T_DPI_T
    T_DPI_S
    A_DPI
  }
}

AirportCdmPartner <|-- AirTrafficControl [[{[M2]}]]
AirportCdmPartner <|-- AircraftOperator [[{[M1]}]]
AirportCdmPartner <|-- GroundHandler [[{[M6]}]]
AirportCdmPartner <|-- NetworkOperations [[{[M1]}]]
AirportCdmPartner <|-- StandGateManagement [[{[M4]}]]
Milestone <|-- AircraftReady [[{[M12]}]]
Milestone <|-- AtcFlightPlanActivated [[{[M1]}]]
Milestone <|-- BoardingStarts [[{[M11]}]]
Milestone <|-- Eobt2hrCheck [[{[M2]}]]
Milestone <|-- FinalApproach [[{[M5]}]]
Milestone <|-- FinalConfirmationOfTobt [[{[M9]}]]
Milestone <|-- GroundHandlingStarted [[{[M8]}]]
Milestone <|-- InBlockMilestone [[{[M7]}]]
Milestone <|-- Landed [[{[M6]}]]
Milestone <|-- LocalRadarUpdate [[{[M4]}]]
Milestone <|-- OffBlockMilestone [[{[M15]}]]
Milestone <|-- StartUpApproved [[{[M14]}]]
Milestone <|-- StartUpRequested [[{[M13]}]]
Milestone <|-- TakeOffFromOutstation [[{[M3]}]]
Milestone <|-- TakeOffMilestone [[{[M16]}]]
Milestone <|-- TsatIssued [[{[M10]}]]

Milestone "*" -- "1" Flight : tracks progress of [[{[M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12, M13, M14, M15, M16]}]]
TurnRound "1" o-- "2" Flight : comprises arrival and departure flight [[{[M1]}]]
Flight "1" -- "1" Aircraft : operates with [[{[M1]}]]
Flight "1" -- "1" AtcFlightPlan : described by [[{[M1]}]]
Flight "1" -- "0..1" AirportSlot : corresponds to [[{[M1]}]]
Flight "1" o-- "1..*" TimeQuantity : records [[{[M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12, M13, M14, M15, M16]}]]
AircraftOperator ..> AtcFlightPlan : submits [[{[M1]}]]
Ifps ..> AtcFlightPlan : distributes [[{[M1]}]]
AtcSystem ..> TimeQuantity : provides actual/target times [[{[M3, M4, M5, M6, M9, M10, M16]}]]
Acars ..> TimeQuantity : provides actual times [[{[M6, M7, M15, M16]}]]
NetworkOperations ..> EtfmsSystem : monitors flight progress with [[{[M3]}]]
EtfmsSystem ..> FumMessage : sends [[{[M3]}]]
AirportCdmPlatform ..> DpiMessage : sends [[{[M1, M2, M3, M10, M15]}]]
AirportCdmPlatform ..> FsaMessage : triggers [[{[M16]}]]
AirportCdmPlatform ..> MvtMessage : triggers [[{[M16]}]]
NetworkOperations "1" -- "*" DpiMessage : receives [[{[M1, M2, M3, M10, M15]}]]
AirportCdmPlatform "1" -- "*" Flight : processes [[{[M1, M2, M4, M10, M11, M12, M13, M14, M15]}]]
Milestone ..> AirportCdmPlatform : executed within [[{[M1, M2, M4, M10, M11, M12, M13, M14, M15]}]]

legend right
  |= Notation |= Meaning |
  | A --|> B | A is a subclass of B (generalization); B drawn above A |
  | A -- B | association; end labels are multiplicities (1, 0..1, *, 1..*) |
  | A *-- B | composition: B is a part of A |
  | A o-- B | aggregation: B is grouped by A |
  | A ..> B | dependency: A uses B |
  | (E) (B) (C) | entity, boundary, control (Jacobson) |
endlegend
@enduml
