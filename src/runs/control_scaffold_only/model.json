{
  "packages": [
    {
      "name": "Stakeholders",
      "description": "the parties that take part in the process and originate or receive its information."
    },
    {
      "name": "Flights",
      "description": "the flight, turn-round, aircraft, and the flight plan and slot that describe them, including the flight's operational status."
    },
    {
      "name": "Timings",
      "description": "the time quantities that describe a flight's progress, each with its origin, accuracy, and tolerance."
    },
    {
      "name": "Milestones",
      "description": "the sixteen events, each with its trigger, timing rule, effect, and procedure."
    },
    {
      "name": "Systems",
      "description": "the technical systems that hold, compute, and display the process information, including the CDM platform and its actions."
    },
    {
      "name": "Messages",
      "description": "the messages exchanged between stakeholders and systems."
    }
